<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaBase</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- 🔹 Navbar superior -->
        <nav class="main-header navbar navbar-expand navbar-dark bg-dark">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Carnes La Casona
            </a>
            <ul class="navbar-nav ms-auto">
                @if (Context.Session.GetString("Usuario") != null)
                {
                    <li class="nav-item">
                        <span class="navbar-text text-white small me-3">
                            Usuario: <strong>@Context.Session.GetString("Usuario")</strong>
                        </span>
                    </li>
                    <li class="nav-item">
                        <span id="fechaHora" class="navbar-text text-white small me-3"></span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Login" asp-action="Logout">Logout</a>
                    </li>
                }
            </ul>
        </nav>

        <!-- 🔹 Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="@Url.Action("Index", "Home")" class="brand-link">
                <span class="brand-text font-weight-light">SistemaBase</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Inicio</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Administrativo" asp-action="Index">
                                <i class="nav-icon fas fa-briefcase"></i>
                                <p>Administrativo</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-file-invoice-dollar"></i>
                                <p>Facturación</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-hand-holding-usd"></i>
                                <p>Cuentas por Cobrar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-money-check-alt"></i>
                                <p>Cuentas por Pagar</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Ingresos</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>Gastos</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-book"></i>
                                <p>Cuentas Contables</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-percent"></i>
                                <p>Impuestos</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index">
                                <i class="nav-icon fas fa-balance-scale"></i>
                                <p>Presupuesto</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- 🔹 Contenido principal -->
        <div class="content-wrapper">
            <section class="content pt-3">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- 🔹 Footer -->
        <footer class="main-footer text-center">
            <strong>&copy; 2026 Carnes La Casona.</strong> Todos los derechos reservados.
        </footer>
    </div>

    <!-- 🔹 Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function actualizarFechaHora() {
            const ahora = new Date();
            const opciones = {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            };
            document.getElementById("fechaHora").textContent =
                ahora.toLocaleString("es-CR", opciones);
        }
        setInterval(actualizarFechaHora, 1000);
        actualizarFechaHora();
    </script>
</body>
</html>
