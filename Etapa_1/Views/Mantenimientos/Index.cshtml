@{
    ViewBag.Title = "Panel de Mantenimientos";
    Layout = "~/Views/Shared/Layout_Home.cshtml"; // tu layout principal
}



<section class="content">
    <div class="container-fluid">
        <!-- 🔹 Título -->
        <h1 class="mb-4">@ViewBag.Title</h1>

        <!-- 🔹 Tarjetas -->
        <div class="row">
            <!-- Usuarios -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h5 class="fw-normal">Usuarios</h5>
                        <p>Gestión de usuarios</p>
                    </div>
                    <div class="icon"><i class="fas fa-user"></i></div>
                    <a href="@Url.Action("Index", "Usuario")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Clientes -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h5 class="fw-normal">Clientes</h5>
                        <p>Gestión de clientes</p>
                    </div>
                    <div class="icon"><i class="fas fa-users"></i></div>
                    <a href="@Url.Action("Index", "Cliente")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Compras -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h5 class="fw-normal">Compras</h5>
                        <p>Gestión de compras</p>
                    </div>
                    <div class="icon"><i class="fas fa-shopping-cart"></i></div>
                    <a href="@Url.Action("Index", "Compra")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Ventas -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-dark text-white">
                    <div class="inner">
                        <h5 class="fw-normal">Ventas</h5>
                        <p>Gestión de ventas</p>
                    </div>
                    <div class="icon"><i class="fas fa-chart-line"></i></div>
                    <a href="@Url.Action("Index", "Venta")" class="small-box-footer text-white">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Reportes -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h5 class="fw-normal">Reportes</h5>
                        <p>Generación de reportes</p>
                    </div>
                    <div class="icon"><i class="fas fa-file-alt"></i></div>
                    <a href="@Url.Action("Index", "Reporte")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Inventario -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h5 class="fw-normal">Inventario</h5>
                        <p>Gestión de inventario</p>
                    </div>
                    <div class="icon"><i class="fas fa-boxes"></i></div>
                    <a href="@Url.Action("Index", "Inventario")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>

            <!-- Proveedores -->
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h5 class="fw-normal">Proveedores</h5>
                        <p>Gestión de proveedores</p>
                    </div>
                    <div class="icon"><i class="fas fa-truck"></i></div>
                    <a href="@Url.Action("Index", "Proveedor")" class="small-box-footer">
                        Más opciones <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

